# SPDX-License-Identifier: MIT

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{tex,bib}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,cff}]
indent_size = 2

[Makefile]
indent_style = tab

# The deposited file, the sources of the report and the vendored class keep
# their bytes; an editor must not rewrite them.
[{publication/**,report/**,paper/IEEEtran.*}]
trim_trailing_whitespace = false
insert_final_newline = unset
